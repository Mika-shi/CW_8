@model MyForum.ViewModels.TopicCreateViewModel

@{
    ViewData["Title"] = "Создание темы";
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 700px;">

        <h2 class="mb-4">Создать новую тему</h2>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Название темы</label>
                <input asp-for="Title" class="form-control" placeholder="Введите название темы" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label">Содержание</label>
                <textarea asp-for="Content" class="form-control" rows="8" placeholder="Введите текст темы"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Создать тему</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Отмена</a>

        </form>

    </div>
</div>