@model MyForum.Models.Topic

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">

    <div class="card mb-4">
        <div class="card-body">

            <div class="d-flex gap-3">

                @if (!string.IsNullOrEmpty(Model.User?.AvatarPath))
                {
                    <img src="@Model.User.AvatarPath" style="width:60px;height:60px;object-fit:cover;border-radius:50%;flex-shrink:0;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-secondary text-white"
                         style="width:60px;height:60px;border-radius:50%;font-weight:bold;flex-shrink:0;">
                        @Model.User?.UserName?.Substring(0, 1).ToUpper()
                    </div>
                }

                <div class="flex-grow-1">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="mb-0">@Model.Title</h3>
                        <small class="text-muted">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>

                    <div class="mb-3">
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="text-decoration-none">
                            @Model.User?.UserName
                        </a>
                    </div>

                    <div>
                        @Model.Content
                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Ответы</h4>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <button type="button" id="scrollToReplyButton" class="btn btn-primary">Ответить</button>
        }
    </div>

    <div id="repliesContainer" data-topic-id="@Model.Id"></div>
    
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div id="replyForm" class="mt-4">

            <h5 class="mb-3">Ваш ответ</h5>

            <textarea id="replyText" class="form-control mb-2" rows="5" placeholder="Введите ответ"></textarea>

            <div id="replyError" class="text-danger mb-2"></div>

            <button type="button" id="scrollToReplyButton" class="btn btn-primary" data-topic-id="@Model.Id">
                Отправить
            </button>
        </div>
    }

</div>