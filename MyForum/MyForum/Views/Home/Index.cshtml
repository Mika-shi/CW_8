@model List<MyForum.Models.Topic>

@{
    ViewData["Title"] = "Forum";
}

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Темы форума</h2>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-controller="Topic" asp-action="Create" class="btn btn-primary">Создать тему</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">
        Пока нет ни одной темы.
    </div>
}
else
{
    <div class="list-group">

        @foreach (var topic in Model)
        {
            <a asp-controller="Topic" asp-action="Details" asp-route-id="@topic.Id"
               class="list-group-item list-group-item-action">

                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">@topic.Title</h5>

                    <small>@topic.CreatedOn.ToString("dd.MM.yyyy HH:mm")</small>
                </div>

                <div class="d-flex justify-content-between mt-2">
                    <span>Автор: @topic.User?.UserName</span>
                    <span>Ответов: @topic.Replies.Count</span>
                </div>
            </a>
        }
    </div>
}
</div>